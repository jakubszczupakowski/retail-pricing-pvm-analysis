		sourceColumn: [Day_Number]

		annotation SummarizationSetBy = Automatic

	partition DIM_Calendar = calculated
		mode: import
		source =
				
				VAR MinYear = 2024
				VAR MaxYear = 2025
				RETURN
				ADDCOLUMNS(
				    CALENDAR(DATE(MinYear, 1, 1), DATE(MaxYear, 12, 31)),
				    "Year", YEAR([Date]),
				    "Year_Quarter", "Q" & FORMAT([Date], "q") & " " & YEAR([Date]),
				    "Year_Month", FORMAT([Date], "yyyy-MM"),
				    "Month_Name", FORMAT([Date], "mmm"),
				    "Month_Number", MONTH([Date]),
				    "Day_of_Week", FORMAT([Date], "ddd"),
				    "Day_Number", WEEKDAY([Date], 2)
				)

	annotation PBI_Id = 4b7af5d87de94025aabb667002328366

